# ---- Providers -------------------------------------------------------------
# Embeddings: "openai" (default) or "hash" (offline, lexical; for demos/tests only)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# LLM: "openai" (any OpenAI-compatible endpoint via OPENAI_BASE_URL)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible server (Azure proxy, vLLM, Ollama, ...)
# OPENAI_BASE_URL=http://localhost:11434/v1

# ---- Paths -----------------------------------------------------------------
CONTRACTS_DIR=./contracts
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=contracts
SQLITE_PATH=./data/documents.db

# ---- Chunking --------------------------------------------------------------
MAX_CHUNK_TOKENS=800
MIN_CHUNK_TOKENS=50
MIN_CLAUSES_FOR_CLAUSE_CHUNKING=3
FALLBACK_CHUNK_SIZE=1000
FALLBACK_CHUNK_OVERLAP=150
EMBED_BATCH_SIZE=64

# ---- Retrieval / chat ------------------------------------------------------
TOP_K=5
# Cosine similarity cut-off (0 disables). Results below it are dropped.
SIMILARITY_THRESHOLD=0.2
MAX_HISTORY_TURNS=6

# ---- Frontend --------------------------------------------------------------
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
