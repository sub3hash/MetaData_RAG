# =============================================================================
# Contract Document Chat - Google Cloud configuration
# =============================================================================

# ---- Gemini auth: choose ONE ---------------------------------------------------
# (A) Gemini API key from Google AI Studio (default):
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_USE_VERTEXAI=false
# (B) Vertex AI with Application Default Credentials (service account / gcloud):
#   GOOGLE_GENAI_USE_VERTEXAI=true   (+ GCP_PROJECT and GCP_LOCATION below; GOOGLE_API_KEY unused)
# (C) Vertex AI express mode: GOOGLE_GENAI_USE_VERTEXAI=true, GOOGLE_API_KEY=<vertex key>, no GCP_PROJECT

# ---- Google Cloud project (Cloud Storage, Firestore, Vector Search use ADC) ----
GCP_PROJECT=your-project-id
GCP_LOCATION=us-central1
# Path to a service-account key, if not using `gcloud auth application-default login`:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Models -------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini          # gemini | hash (offline, tests only)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                  # must match the Vector Search index dimension
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# ---- Contract files ------------------------------------------------------------
CONTRACTS_SOURCE=gcs               # gcs | local
GCS_BUCKET=your-project-contracts
GCS_PREFIX=contracts/
CONTRACTS_DIR=./contracts          # used when CONTRACTS_SOURCE=local

# ---- Document registry + chunk text --------------------------------------------
REGISTRY_BACKEND=firestore         # firestore | sqlite
FIRESTORE_DATABASE=(default)
FIRESTORE_DOCUMENTS_COLLECTION=contract_documents
FIRESTORE_CHUNKS_COLLECTION=contract_chunks
SQLITE_PATH=./data/documents.db    # used when REGISTRY_BACKEND=sqlite

# ---- Vector store --------------------------------------------------------------
VECTOR_STORE=vertex                # vertex | chroma
# Printed by scripts/setup_gcp.py:
VERTEX_INDEX_ID=projects/123/locations/us-central1/indexes/456
VERTEX_INDEX_ENDPOINT_ID=projects/123/locations/us-central1/indexEndpoints/789
VERTEX_DEPLOYED_INDEX_ID=contract_chat_deployed
CHROMA_DIR=./chroma_db             # used when VECTOR_STORE=chroma
CHROMA_COLLECTION=contracts

# ---- Chunking --------------------------------------------------------------------
MAX_CHUNK_TOKENS=800
MIN_CHUNK_TOKENS=50
MIN_CLAUSES_FOR_CLAUSE_CHUNKING=3
FALLBACK_CHUNK_SIZE=1000
FALLBACK_CHUNK_OVERLAP=150
EMBED_BATCH_SIZE=50

# ---- Retrieval / chat --------------------------------------------------------------
TOP_K=5
# Cosine similarity cut-off (0 disables). Tune it on your contracts: the backend
# logs the similarity of every retrieved clause.
SIMILARITY_THRESHOLD=0.5
MAX_HISTORY_TURNS=6

# ---- Frontend ----------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
